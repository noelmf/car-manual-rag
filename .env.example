# Copy to .env and fill in the first three: none of them has a default. The
# fourth is optional and may be left empty.
# .env is gitignored; this file is not. An exported variable wins over it.

# aistudio.google.com/apikey
GEMINI_API_KEY=

# Embedding model. Changing it forces every index to be rebuilt.
GEMINI_EMBEDDING=gemini-embedding-001

# Generation model for the answers.
GEMINI_MODEL=gemini-3.6-flash

# Optional, and the only one: how long the model deliberates before writing.
# Unset, the field is never sent and the model decides for itself. On the
# reference question 'low' cut the wait for the first word from 13.3s to 4.7s
# and the whole answer from 15.8s to 7.9s. Gemini 3 spelling: a model that does
# not know it will reject the request, so leave it unset if you change models.
GEMINI_THINKING=low
